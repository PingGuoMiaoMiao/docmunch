* text=auto eol=lf

# Binary assets
*.pdf binary
*.png binary

# Third-party page snapshots used only by the offline tests. They are not
# project source: marking them vendored keeps GitHub's language bar honest
# (otherwise 480 KB of saved HTML outweighs ~6 k lines of MoonBit).
fixtures/html/* linguist-vendored
fixtures/html/** linguist-vendored

# Oracle output generated by the Node Readability reference implementation.
tools/oracle/out/* linguist-vendored
tools/oracle/package-lock.json linguist-generated

# Docs are documentation, not code.
docs/* linguist-documentation
